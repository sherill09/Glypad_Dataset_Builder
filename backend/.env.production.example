# Copy this file to "backend/.env.production" on your SERVER (not your own
# laptop) and fill in real values, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# See DEPLOYMENT.md for the full walkthrough. ".env.production" is in
# .gitignore on purpose — never commit it, and never paste real secrets
# into chat, a ticket, or a commit message.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# "mongo" here is the *service name* from docker-compose.prod.yml, not
# "localhost" — inside Docker's internal network, that name is how the
# backend container finds the database container (or you can use MongoDB Atlas).
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=glypad

# ---------------------------------------------------------------------------
# File storage — use S3 in production (not the local-disk backend), so
# uploaded files survive a redeploy and aren't tied to one server's disk.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=s3
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# The real domain your frontend is served from, e.g. https://glypad.example.com
# (no trailing slash). If the frontend and backend are served from the same
# domain — the setup in DEPLOYMENT.md, with nginx forwarding /api to the
# backend — this technically isn't even used (same-origin requests don't
# need CORS), but it's good practice to set it correctly anyway.
CORS_ORIGINS=https://your-domain-here.com

MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Auth (sign-in tokens)
# ---------------------------------------------------------------------------
# REQUIRED — do not deploy with the dev default. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it secret and keep a backup somewhere safe (a password manager, not
# a text file on the server) — if you lose it and set a new one, everyone
# currently signed in is signed out. If it ever leaks, generate a new one
# immediately (that invalidates every existing login, which is the point).
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# AI region suggestions (Google Gemini)
# ---------------------------------------------------------------------------
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
# Leave blank to deploy without this feature for now — everything else
# works fine, the "AI suggest" button just shows a clear "not configured"
# message instead of a real suggestion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
