# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore on purpose — never commit real secrets.

# ---------------------------------------------------------------------------
# Database (MongoDB running in Docker or cloud)
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=glypad

# ---------------------------------------------------------------------------
# File storage backend: "local" or "s3"
#   local -> files are saved on this machine's disk, under LOCAL_STORAGE_DIR.
#            Use this for development — no AWS account needed.
#   s3    -> files are saved in an Amazon S3 bucket. Use this in production.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../storage/local_files

# Only required when STORAGE_BACKEND=s3
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Max upload size the API will accept, in megabytes.
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Auth (sign-in tokens)
# ---------------------------------------------------------------------------
# Every login issues a signed token (a JWT). SECRET_KEY is what signs it —
# anyone who has this value can forge a valid login for any account, so:
#   - it must be a long random string, not a real word or phrase
#   - it must be DIFFERENT in every environment (dev, staging, production)
#   - it must never be committed to git (this file is just an example)
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The value below is a placeholder for local development only — replace it
# before deploying anywhere real.
SECRET_KEY=dev-only-secret-change-me

# How long a login stays valid before the person has to sign in again.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# AI region suggestions (Google Gemini)
# ---------------------------------------------------------------------------
# Powers the "AI suggest" button, which asks a Gemini vision model to
# propose regions to trace on a drawing. Leave this blank to develop
# without it — the feature returns a clear "not configured" error instead
# of crashing, everything else in the app works normally either way.
#
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Which Gemini model to call. gemini-2.0-flash is fast and cheap and is a
# good default; swap in a different Gemini model name here if needed.
GEMINI_MODEL=gemini-2.0-flash
